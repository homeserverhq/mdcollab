# General settings
MDCOLLAB_BASE_URL="https://hedgedoc2.localhost"
MDCOLLAB_SESSION_SECRET="change_me_in_production"

# Database settings
MDCOLLAB_DATABASE_TYPE="postgres"
MDCOLLAB_DATABASE_HOST="db"
MDCOLLAB_DATABASE_PORT="5432"
MDCOLLAB_DATABASE_NAME="hedgedoc"
MDCOLLAB_DATABASE_USERNAME="hedgedoc"
MDCOLLAB_DATABASE_PASSWORD="password"

# Uploads
MDCOLLAB_MEDIA_BACKEND="filesystem"
MDCOLLAB_MEDIA_BACKEND_FILESYSTEM_UPLOAD_PATH="uploads/"

# Auth
MDCOLLAB_AUTH_LOCAL_ENABLE_LOGIN="true"
MDCOLLAB_AUTH_LOCAL_ENABLE_REGISTER="true"
