# This example just lists all available environment variables.
# Thid does not represent the default settings of mdCollab.
# Please refer to the documentation for details:

# General settings
MDCOLLAB_BASE_URL=http://localhost:8080
MDCOLLAB_RENDERER_BASE_URL=http://localhost:8080
MDCOLLAB_BACKEND_PORT=3000
MDCOLLAB_LOG_LEVEL=info
MDCOLLAB_LOG_SHOW_TIMESTAMP=true

# Auth general
MDCOLLAB_AUTH_ALLOW_PROFILE_EDITS=true
MDCOLLAB_AUTH_ALLOW_CHOOSE_USERNAME=true
MDCOLLAB_AUTH_SYNC_SOURCE=MYOIDC
MDCOLLAB_AUTH_SESSION_SECRET=change-me-in-production
MDCOLLAB_AUTH_SESSION_LIFETIME=864000

# Auth: Local account system
MDCOLLAB_AUTH_LOCAL_ENABLE_LOGIN=true
MDCOLLAB_AUTH_LOCAL_ENABLE_REGISTER=true
MDCOLLAB_AUTH_LOCAL_MINIMAL_PASSWORD_STRENGTH=2

# Auth: LDAP
MDCOLLAB_AUTH_LDAP_SERVERS=MYLDAP
MDCOLLAB_AUTH_LDAP_MYLDAP_URL=ldap://ldap.example.com:389
MDCOLLAB_AUTH_LDAP_MYLDAP_PROVIDER_NAME="My LDAP"
MDCOLLAB_AUTH_LDAP_MYLDAP_BIND_DN=cn=admin,dc=example,dc=com
MDCOLLAB_AUTH_LDAP_MYLDAP_BIND_CREDENTIALS=adminpassword
MDCOLLAB_AUTH_LDAP_MYLDAP_SEARCH_BASE=dc=example,dc=com
MDCOLLAB_AUTH_LDAP_MYLDAP_SEARCH_FILTER=(uid={{username}})
MDCOLLAB_AUTH_LDAP_MYLDAP_SEARCH_ATTRIBUTES=dn,cn,mail
MDCOLLAB_AUTH_LDAP_MYLDAP_USER_ID_FIELD=mail
MDCOLLAB_AUTH_LDAP_MYLDAP_DISPLAY_NAME_FIELD=cn
MDCOLLAB_AUTH_LDAP_MYLDAP_EMAIL_FIELD=mail
MDCOLLAB_AUTH_LDAP_MYLDAP_PROFILE_PICTURE_FIELD=picture
#MDCOLLAB_AUTH_LDAP_MYLDAP_TLS_CERT_PATHS=/path/to/cert.pem
MDCOLLAB_AUTH_LDAP_MYLDAP_TLS_REJECT_UNAUTHORIZED=true
MDCOLLAB_AUTH_LDAP_MYLDAP_TLS_SNI_NAME=admin.example.com
MDCOLLAB_AUTH_LDAP_MYLDAP_TLS_ALLOW_PARTIAL_TRUST_CHAIN=false
MDCOLLAB_AUTH_LDAP_MYLDAP_TLS_MIN_VERSION=TLSv1.2
MDCOLLAB_AUTH_LDAP_MYLDAP_TLS_MAX_VERSION=TLSv1.3

# Auth: OIDC
MDCOLLAB_AUTH_OIDC_PROVIDERS=MYOIDC
MDCOLLAB_AUTH_OIDC_MYOIDC_ISSUER=https://oidc.example.com
MDCOLLAB_AUTH_OIDC_MYOIDC_PROVIDER_NAME="My OIDC Provider"
MDCOLLAB_AUTH_OIDC_MYOIDC_CLIENT_ID=mdcollab
MDCOLLAB_AUTH_OIDC_MYOIDC_CLIENT_SECRET=very-secret
MDCOLLAB_AUTH_OIDC_MYOIDC_THEME=gitlab
MDCOLLAB_AUTH_OIDC_MYOIDC_AUTHORIZE_URL=https://oidc.example.com/auth
MDCOLLAB_AUTH_OIDC_MYOIDC_TOKEN_URL=https://oidc.example.com/token
MDCOLLAB_AUTH_OIDC_MYOIDC_USERINFO_URL=https://oidc.example.com/userinfo
MDCOLLAB_AUTH_OIDC_MYOIDC_END_SESSION_URL=https://oidc.example.com/logout
MDCOLLAB_AUTH_OIDC_MYOIDC_SCOPE="openid profile email"
MDCOLLAB_AUTH_OIDC_MYOIDC_USER_ID_FIELD=sub
MDCOLLAB_AUTH_OIDC_MYOIDC_USER_NAME_FIELD=preferred_username
MDCOLLAB_AUTH_OIDC_MYOIDC_DISPLAY_NAME_FIELD=name
MDCOLLAB_AUTH_OIDC_MYOIDC_EMAIL_FIELD=email
MDCOLLAB_AUTH_OIDC_MYOIDC_PROFILE_PICTURE_FIELD=picture
MDCOLLAB_AUTH_OIDC_MYOIDC_ENABLE_REGISTRATION=true

# Branding
MDCOLLAB_BRANDING_CUSTOM_NAME="ACME Corp Notes"
MDCOLLAB_BRANDING_CUSTOM_LOGO=https://example.com/assets/custom-logo.png

# Special URLs
MDCOLLAB_URLS_PRIVACY=https://example.com/privacy
MDCOLLAB_URLS_TERMS_OF_USE=https://example.com/terms-of-use
MDCOLLAB_URLS_IMPRINT=https://example.com/imprint

# Database settings
MDCOLLAB_DATABASE_TYPE=sqlite
MDCOLLAB_DATABASE_NAME=./mdcollab.sqlite
#MDCOLLAB_DATABASE_TYPE=postgres # could be mariadb as well
#MDCOLLAB_DATABASE_HOST=localhost
#MDCOLLAB_DATABASE_PORT=5432
#MDCOLLAB_DATABASE_NAME=mdcollab
#MDCOLLAB_DATABASE_USERNAME=mdcollab
#MDCOLLAB_DATABASE_PASSWORD=very-secret

# External integrations
MDCOLLAB_PLANTUML_SERVER=https://www.plantuml.com/plantuml
MDCOLLAB_IMAGE_PROXY=https://img-proxy.example.com/

# Uploads
MDCOLLAB_MEDIA_MAX_UPLOAD_SIZE=20971520
MDCOLLAB_MEDIA_BACKEND_TYPE=filesystem
MDCOLLAB_MEDIA_BACKEND_FILESYSTEM_UPLOAD_PATH=uploads/
#MDCOLLAB_MEDIA_BACKEND_TYPE=azure
#MDCOLLAB_MEDIA_BACKEND_AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account_name;AccountKey=your_account_key;EndpointSuffix=core.windows.net
#MDCOLLAB_MEDIA_BACKEND_AZURE_CONTAINER=mdcollab-uploads
#MDCOLLAB_MEDIA_BACKEND_TYPE=s3
#MDCOLLAB_MEDIA_BACKEND_S3_ACCESS_KEY=your_access_key_id
#MDCOLLAB_MEDIA_BACKEND_S3_SECRET_KEY=your_secret_access_key
#MDCOLLAB_MEDIA_BACKEND_S3_REGION=us-east-1
#MDCOLLAB_MEDIA_BACKEND_S3_BUCKET=mdcollab-uploads
#MDCOLLAB_MEDIA_BACKEND_S3_ENDPOINT=https://s3.amazonaws.com
#MDCOLLAB_MEDIA_BACKEND_S3_PATH_STYLE=false
#MDCOLLAB_MEDIA_BACKEND_TYPE=imgur
#MDCOLLAB_MEDIA_BACKEND_IMGUR_CLIENT_ID=your_imgur_client_id
#MDCOLLAB_MEDIA_BACKEND_TYPE=webdav
#MDCOLLAB_MEDIA_BACKEND_WEBDAV_CONNECTION_STRING=https://user:token@example.com/dav/mdcollab-uploads/
#MDCOLLAB_MEDIA_BACKEND_WEBDAV_UPLOAD_DIR=mdcollab-uploads
#MDCOLLAB_MEDIA_BACKEND_WEBDAV_PUBLIC_URL=https://example.com/download/mdcollab-uploads/

# Note settings
MDCOLLAB_NOTE_FORBIDDEN_ALIASES=help,about,forbidden
MDCOLLAB_NOTE_MAX_LENGTH=1000000
MDCOLLAB_NOTE_PERMISSIONS_MAX_GUEST_LEVEL=write
MDCOLLAB_NOTE_PERMISSIONS_DEFAULT_EVERYONE=read
MDCOLLAB_NOTE_PERMISSIONS_DEFAULT_LOGGED_IN=write
MDCOLLAB_NOTE_REVISION_RETENTION_DAYS=60
MDCOLLAB_NOTE_PERSIST_INTERVAL=10
